      google.script.run.withSuccessHandler(() => { 
        const currentUser = JSON.parse(localStorage.getItem('shopUser'));
        if(currentUser && currentUser.userId === d.userId) {
          localStorage.setItem('shopUser', JSON.stringify(d));
