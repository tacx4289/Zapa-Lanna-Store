    // แยก address string กลับเป็นฟิลด์ (สำหรับเติมใน userModal)
    function parseAddressToUserModal(addrStr) {
      const defaults = { no:'-', village:'-', moo:'-', road:'-', soi:'-', tambon:'-', amphoe:'-', province:'-', postcode:'-' };
      try {
        const patterns = [
          { key:'no',       re:/เลขที่\s*([^,]+)/ },
          { key:'village',  re:/หมู่บ้าน\s*([^,]+)/ },
          { key:'moo',      re:/หมู่ที่\s*([^,]+)/ },
          { key:'road',     re:/ถนน\s*([^,]+)/ },
          { key:'soi',      re:/ซอย\s*([^,]+)/ },
          { key:'tambon',   re:/ตำบล\/แขวง\s*([^,]+)/ },
          { key:'amphoe',   re:/อำเภอ\/เขต\s*([^,]+)/ },
          { key:'province', re:/จังหวัด\s*([^,]+)/ },
          { key:'postcode', re:/รหัสไปรษณีย์\s*([^,]+)/ }
        ];
        patterns.forEach(p => {
          const m = addrStr.match(p.re);
          if(m) defaults[p.key] = m[1].trim();
        });
      } catch(e) {}
      document.getElementById('uAddr_no').value       = defaults.no;
      document.getElementById('uAddr_village').value  = defaults.village;
      document.getElementById('uAddr_moo').value      = defaults.moo;
      document.getElementById('uAddr_road').value     = defaults.road;
      document.getElementById('uAddr_soi').value      = defaults.soi;
      document.getElementById('uAddr_tambon').value   = defaults.tambon;
      document.getElementById('uAddr_amphoe').value   = defaults.amphoe;
      document.getElementById('uAddr_province').value = defaults.province;
      document.getElementById('uAddr_postcode').value = defaults.postcode;
    }

    function handleRegistration() {
      const email   = document.getElementById('email').value.trim();
      const name    = document.getElementById('name').value.trim();
      const phone   = document.getElementById('phone').value.trim();
      // ตรวจสอบว่ากรอกครบทุกช่อง
      const addrFields = ['addr_no','addr_village','addr_moo','addr_road','addr_soi','addr_tambon','addr_amphoe','addr_province','addr_postcode'];
      for(let f of addrFields) {
        if(!document.getElementById(f).value.trim()) {
          alert('กรุณากรอกข้อมูลที่อยู่ให้ครบทุกช่อง (ถ้าไม่มีให้ใส่ -)');
          document.getElementById(f).focus();
          return;
        }
      }
      if(!email || !name || !phone) { alert('กรุณากรอกข้อมูลให้ครบถ้วน'); return; }
      if(!/^[0-9]{10}$/.test(phone)) { alert('เบอร์โทรต้องเป็นตัวเลข 10 หลักเท่านั้น'); document.getElementById('phone').focus(); return; }
