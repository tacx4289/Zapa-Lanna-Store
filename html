<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shopping App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Kanit', sans-serif; background-color: #f8f9fa; padding-bottom: 80px; }
    .card { max-width: 1000px; margin: auto; border: none; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .login-card { max-width: 450px; margin-top: 50px; }
    .btn-rounded { border-radius: 12px; }
    
    .sticky-header { position: sticky; top: 0; z-index: 1020; background: #f8f9fa; padding-top: 10px; margin-bottom: 10px; }
    .header-content { background: white; padding: 15px; border-radius: 20px; shadow-sm: 0 4px 15px rgba(0,0,0,0.05); }

    /* Category Bar Styling */
    .category-bar {
      overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch;
      padding: 5px 0 15px 0; position: sticky; top: 85px; z-index: 1015;
      background: #f8f9fa; margin-left: -10px; margin-right: -10px; padding-left: 10px;
    }
    .cat-pill {
      display: inline-block; padding: 6px 16px; margin-right: 8px;
      background: white; border: 1px solid #eee; border-radius: 20px;
      color: #666; font-size: 0.9rem; cursor: pointer; transition: all 0.2s;
      box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .cat-pill.active { background: #0d6efd; color: white; border-color: #0d6efd; font-weight: 500; }

    .store-product-card { border-radius: 15px; overflow: hidden; border: 1px solid #eee; background: #fff; height: 100%; display: flex; flex-direction: column; transition: transform 0.2s; position: relative; cursor: pointer; }
    .store-product-card:hover { transform: translateY(-5px); }
    
    .img-container-1to1 { position: relative; width: 100%; padding-top: 100%; overflow: hidden; background: #fff; }
    .store-product-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background-color: #fff; }
    
    .out-of-stock-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(255, 255, 255, 0.7); display: flex; align-items: center; justify-content: center; z-index: 2;
    }
    .out-of-stock-badge { background: rgba(0,0,0,0.7); color: white; padding: 5px 15px; border-radius: 20px; font-weight: bold; font-size: 14px; }
    
    .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 600px; left: 50%; transform: translateX(-50%); background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); border-top: 1px solid #eee; display: flex; justify-content: space-around; padding: 8px 0; z-index: 1030; box-shadow: 0 -5px 20px rgba(0,0,0,0.05); border-radius: 20px 20px 0 0; }
    .nav-item-btn { text-align: center; color: #999; cursor: pointer; font-size: 11px; flex: 1; transition: 0.3s; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .nav-item-btn i { font-size: 22px; display: block; margin-bottom: 2px; }
    .nav-item-btn.active { color: #0d6efd; transform: translateY(-2px); }
    
    .cart-badge { position: absolute; top: -3px; right: 15%; background: #ff3b30; color: white; border-radius: 50%; padding: 1px 5px; font-size: 9px; border: 1.5px solid #fff; font-weight: bold; }
    #orderBadge { right: 28%; }
    #paymentBadge { right: 28%; background: #ff3b30; }
    
    .desc-truncate { font-size: 0.75rem; color: #777; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.2em; }
    .btn-buy-now { background: linear-gradient(45deg, #ff9500, #ff5e00); color: white; border: none; }
    
    .btn-outline-deep-purple { background-color: transparent; color: #311b92; border: 1px solid #311b92; }
    .btn-outline-deep-purple:hover { background-color: #311b92; color: white; }

    .btn-close-floating {
        position: absolute; top: 15px; right: 15px; z-index: 1050;
        background-color: rgba(255,255,255,0.9); border-radius: 50%; padding: 10px; width: 35px; height: 35px;
        background-size: 12px; opacity: 1; box-shadow: 0 2px 8px rgba(0,0,0,0.2); transition: transform 0.2s;
    }
    .btn-close-floating:hover { transform: scale(1.1); background-color: #fff; }
    
    .detail-desc-box { position: relative; }
    .line-clamp-9 { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 9; -webkit-box-orient: vertical; }
    .read-more-btn { display: block; width: 100%; text-align: center; background: transparent; border: none; color: #0d6efd; font-size: 0.9rem; margin-top: 5px; padding: 5px; }
    .read-more-btn:hover { background: rgba(13, 110, 253, 0.05); border-radius: 5px; }
    .sticky-modal-footer { position: sticky; bottom: 0; background: white; padding: 15px; border-top: 1px solid #eee; z-index: 1020; box-shadow: 0 -4px 15px rgba(0,0,0,0.05); }

    .admin-tab-content, .cust-tab-content { animation: fadeIn 0.3s; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    
    .checkout-item-img { width: 60px; height: 60px; object-fit: contain; background: #fff; border: 1px solid #eee; border-radius: 10px; }
    .bank-card { background: #f0f7ff; border: 1px dashed #0d6efd; border-radius: 15px; }
    .qty-control { display: flex; align-items: center; border: 1px solid #eee; border-radius: 8px; overflow: hidden; width: fit-content; }
    .qty-btn-mini { border: none; background: #f8f9fa; padding: 0 8px; font-size: 14px; }
    .qty-btn-lg { width:40px; height:40px; border:1px solid #ddd; background:#fff; font-size:1.2rem; display:flex; align-items:center; justify-content:center; }

    .password-wrapper { position: relative; }
    .password-toggle { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #999; z-index: 10; font-size: 1.2rem; }
    
    .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500; display: inline-block; }
    .status-pending { background-color: #ff3b30; color: white; } 
    .status-paid { background-color: #0d6efd; color: white; }    
    .status-preparing { background-color: #ffc107; color: black; } 
    .status-success { background-color: #28a745; color: white; }   
    .status-info { background-color: #17a2b8; color: white; }
    
    .btn-xs { padding: 0.1rem 0.4rem; font-size: 0.7rem; }

    .img-upload-container { width: 100%; margin-bottom: 10px; }
    .img-upload-main { width: 100%; padding-top: 75%; background: #f0f0f0; border-radius: 12px; position: relative; margin-bottom: 8px; border: 2px dashed #ddd; overflow: hidden; cursor: pointer; }
    .img-upload-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .img-upload-sub { width: 100%; padding-top: 100%; background: #f0f0f0; border-radius: 8px; position: relative; border: 2px dashed #ddd; overflow: hidden; cursor: pointer; }
    .upload-placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 2rem; pointer-events: none; }
    .uploaded-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: #fff; }
    .btn-remove-img { position: absolute; top: 2px; right: 2px; background: rgba(255,0,0,0.8); color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 10px; cursor: pointer; z-index: 10; }

    /* ปรับแต่งปุ่มลูกศรใน Carousel ตามคำขอ */
    .carousel-control-prev-icon, .carousel-control-next-icon {
      background-color: rgba(0, 0, 0, 0.4) !important; /* วงกลมสีดำบางๆ */
      border-radius: 50%;
      background-size: 55% 55%;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
/* ปรับแต่งปุ่มลูกศร: วงกลมดำเข้มขึ้น และหัวลูกศรหนาขึ้น */
    .carousel-control-prev-icon, .carousel-control-next-icon {
      background-color: rgba(0, 0, 0, 0.8) !important; /* เปลี่ยนจาก 0.4 เป็น 0.8 ให้ดำเข้มขึ้น */
      border-radius: 50%;
      background-size: 50% 50%; /* ปรับขนาดเล็กลงนิดหน่อยเพื่อให้ดูหนาและสมส่วน */
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* เพิ่ม stroke และ stroke-width เพื่อให้ลูกศรดูหนาขึ้น */
    .carousel-control-prev-icon { 
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff' stroke='%23fff' stroke-width='1.5'%3e%3cpath d='M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z'/%3e%3c/svg%3e") !important; 
    }
    
    .carousel-control-next-icon { 
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff' stroke='%23fff' stroke-width='1.5'%3e%3cpath d='M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e") !important; 
    }
  </style>
</head>
<body>

  <div class="container py-3">
    <div id="mainPage" class="card login-card p-4 text-center">
      <h2 class="mb-4 fw-bold">Zapa Lanna Store</h2>
      <div class="d-grid gap-3">
        <button type="button" class="btn btn-primary btn-lg btn-rounded shadow-sm" onclick="enterStoreAsGuest()"><i class="bi bi-shop me-2"></i>เข้าชมร้านค้า</button>
        <button type="button" class="btn btn-success btn-lg btn-rounded shadow-sm" onclick="showCustomerLogin()"><i class="bi bi-person-check me-2"></i>เข้าสู่ระบบ / สมัครสมาชิก</button>
        <button type="button" class="btn btn-outline-dark btn-lg btn-rounded" onclick="showAdminLogin()">ทางเข้าแอดมิน</button>
      </div>
    </div>

    <div id="adminLoginPage" class="card login-card p-4 text-center" style="display:none;">
      <h3 class="mb-4">แอดมินเข้าสู่ระบบ</h3>
      <div class="password-wrapper mb-4">
        <input type="password" id="adminPass" class="form-control btn-rounded" placeholder="ใส่รหัสผ่านแอดมิน" style="padding-right: 45px;">
        <i class="bi bi-eye password-toggle" id="togglePassIcon" onclick="toggleAdminPassword()"></i>
      </div>
      <button id="btnLoginAdmin" class="btn btn-dark w-100 btn-rounded mb-2" onclick="loginAdmin()">เข้าสู่หน้าจัดการ</button>
      <div class="mt-2">
         <button class="btn btn-link text-muted small text-decoration-none" onclick="forgotAdminPassword()">ลืมรหัสผ่าน?</button>
      </div>
      <button class="btn btn-light w-100 btn-rounded mt-2" onclick="goBack()">ย้อนกลับ</button>
    </div>

    <div id="customerPage" class="card login-card p-4" style="display:none;">
      <div id="welcomeBack" style="display:none;" class="text-center">
        <h3 id="welcomeText" class="mb-3 fw-bold"></h3>
        <button class="btn btn-success w-100 btn-lg btn-rounded mb-3 shadow-sm" onclick="enterStore()">เข้าร้านค้า</button>
        <button class="btn btn-link text-decoration-none" onclick="resetUser()">ลงทะเบียนใหม่</button>
      </div>
      <div id="registrationForm" style="display:none;">
        <h3 class="text-center mb-4">ลงทะเบียนลูกค้า</h3>
        <input type="email" id="email" class="form-control mb-2" placeholder="อีเมล" required>
        <input type="text" id="name" class="form-control mb-2" placeholder="ชื่อ-นามสกุล" required>
        <div class="mb-2">
          <label class="small text-muted fw-bold">ที่อยู่สำหรับจัดส่ง <span class="text-danger">*</span> (กรอกให้ครบทุกช่อง ถ้าไม่มีใส่ -)</label>
          <div class="row g-2 mt-1">
            <div class="col-6"><input type="text" id="addr_no" class="form-control form-control-sm" placeholder="เลขที่ *"></div>
            <div class="col-6"><input type="text" id="addr_village" class="form-control form-control-sm" placeholder="หมู่บ้าน *"></div>
            <div class="col-6"><input type="text" id="addr_moo" class="form-control form-control-sm" placeholder="หมู่ที่ *"></div>
            <div class="col-6"><input type="text" id="addr_road" class="form-control form-control-sm" placeholder="ถนน *"></div>
            <div class="col-6"><input type="text" id="addr_soi" class="form-control form-control-sm" placeholder="ซอย *"></div>
            <div class="col-6"><input type="text" id="addr_tambon" class="form-control form-control-sm" placeholder="ตำบล/แขวง *"></div>
            <div class="col-6"><input type="text" id="addr_amphoe" class="form-control form-control-sm" placeholder="อำเภอ/เขต *"></div>
            <div class="col-6"><input type="text" id="addr_province" class="form-control form-control-sm" placeholder="จังหวัด *"></div>
            <div class="col-12"><input type="text" id="addr_postcode" class="form-control form-control-sm" placeholder="รหัสไปรษณีย์ *"></div>
          </div>
        </div>
        <input type="tel" id="phone" class="form-control mb-3" placeholder="เบอร์โทร * (10 หลัก)" required maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'').substring(0,10)" pattern="[0-9]{10}">
        <button class="btn btn-primary w-100 btn-rounded mb-2" onclick="handleRegistration()">สมัครสมาชิก</button>
        <p class="text-center small mt-2">มีบัญชีแล้ว? <button class="btn btn-link p-0 small" onclick="showLoginOldUser()">เข้าสู่ระบบ</button></p>
      </div>
      <div id="loginOldUserForm" style="display:none;" class="text-center">
        <h3 class="mb-4">เข้าสู่ระบบ</h3>
        <input type="email" id="loginEmail" class="form-control mb-2" placeholder="อีเมล">
        <input type="tel" id="loginPhone" class="form-control mb-3" placeholder="เบอร์โทร (10 หลัก)" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'').substring(0,10)" pattern="[0-9]{10}">
        <button class="btn btn-success w-100 btn-rounded mb-2" onclick="handleOldUserLogin()">เข้าสู่ระบบ</button>
        <div class="d-flex justify-content-between mt-3 px-2">
           <button class="btn btn-link p-0 small text-decoration-none" onclick="showRegistrationForm()">ยังไม่มีบัญชี?</button>
           <button class="btn btn-link p-0 small text-decoration-none text-danger" onclick="showForgotPassword()">ลืมรหัสผ่าน?</button>
        </div>
      </div>
      <button class="btn btn-light w-100 btn-rounded mt-3" onclick="goBack()">ย้อนกลับ</button>
    </div>

    <div id="storeFront" style="display:none;">
      <div class="sticky-header">
        <div class="d-flex justify-content-between align-items-center header-content shadow-sm">
          <div>
            <h6 class="mb-0 text-muted small">ยินดีต้อนรับ</h6>
            <div class="fw-bold" id="custDisplayName">...</div>
          </div>
          <div class="d-flex gap-2" id="custHeaderBtns">
            <!-- ปุ่มจะถูก render ตามสถานะ guest/member -->
          </div>
        </div>
        <div class="category-bar" id="custCategoryBar" style="display:none;">
          <span class="cat-pill" onclick="filterCategory('ตำรา (ไฟล์)', this)">ตำรา (ไฟล์)</span>
          <span class="cat-pill" onclick="filterCategory('เอกสารตำรา', this)">ตำรา (เอกสาร)</span>
          <span class="cat-pill" onclick="filterCategory('วัตถุมงคล', this)">วัตถุมงคล</span>
          <span class="cat-pill" onclick="filterCategory('อื่น ๆ', this)">อื่น ๆ</span>
        </div>
      </div>
      
      <div id="cust-shop" class="cust-tab-content">
        <div class="row g-3" id="productGrid"></div>
      </div>
      <div id="cust-status" class="cust-tab-content" style="display:none;"><div id="orderStatusList" class="p-2"></div></div>
      <div id="cust-payment" class="cust-tab-content" style="display:none;">
        <div id="paymentList" class="p-2"></div>
      </div>
      
      <div class="bottom-nav" id="custBottomNav">
        <div class="nav-item-btn active" onclick="switchCustTab('cust-shop', this)"><i class="bi bi-house-door-fill"></i>หน้าร้าน</div>
        <div class="nav-item-btn" id="navOrderStatus" onclick="switchCustTab('cust-status', this)"><i class="bi bi-truck"></i>ติดตามคำสั่งซื้อ<span id="orderBadge" class="cart-badge" style="display:none;">0</span></div>
        <div class="nav-item-btn" id="navPayment" onclick="switchCustTab('cust-payment', this)"><i class="bi bi-cash-stack"></i>แจ้งชำระเงิน<span id="paymentBadge" class="cart-badge" style="display:none;">0</span></div>
      </div>
    </div>

    <div id="adminDashboard" style="display:none;">
      <div class="sticky-header">
        <div class="card p-3 mb-2 border-0 shadow-sm rounded-4">
          <div class="d-flex justify-content-between mb-3 align-items-center">
            <h4>ระบบจัดการแอดมิน</h4>
            <div class="d-flex gap-2">
               <button class="btn btn-outline-primary btn-sm rounded-circle" style="width:32px; height:32px; display:flex; align-items:center; justify-content:center;" onclick="openAdminProfileModal()">
                 <i class="bi bi-person-fill"></i>
               </button>
               <button class="btn btn-danger btn-sm rounded-pill" onclick="logout()">ออกจากระบบ</button>
            </div>
          </div>
          <ul class="nav nav-pills nav-fill mb-2 bg-light p-1 rounded-pill" id="adminTabs">
            <li class="nav-item"><a class="nav-link active rounded-pill" onclick="switchAdminTab('tab-products', this)">สินค้า</a></li>
            <li class="nav-item"><a class="nav-link rounded-pill position-relative" onclick="switchAdminTab('tab-orders', this)">คำสั่งซื้อ <span id="adminOrderBadge" class="badge bg-danger rounded-circle" style="font-size: 10px; padding: 3px 6px;">0</span></a></li>
            <li class="nav-item"><a class="nav-link rounded-pill" onclick="switchAdminTab('tab-customers', this)">ลูกค้า</a></li>
          </ul>
          <div id="admin-sticky-action" class="mt-2">
             <button id="addProductBtn" class="btn btn-primary btn-sm rounded-pill w-100" onclick="openProductModal()">+ เพิ่มสินค้าใหม่</button>
             <div id="searchBarContainer" style="display:none;" class="mt-2">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                  <input type="text" id="universalSearch" class="form-control border-start-0" placeholder="ค้นหา..." onkeyup="handleUniversalSearch()">
                </div>
                <div id="searchResultCount" class="text-end text-muted small mt-1" style="font-size: 0.8rem;"></div>
             </div>
          </div>
        </div>
        <div class="category-bar" id="adminCategoryBar" style="display:none;">
           <span class="cat-pill" onclick="filterAdminCategory('ตำรา (ไฟล์)', this)">ตำรา (ไฟล์)</span>
           <span class="cat-pill" onclick="filterAdminCategory('เอกสารตำรา', this)">ตำรา (เอกสาร)</span>
           <span class="cat-pill" onclick="filterAdminCategory('วัตถุมงคล', this)">วัตถุมงคล</span>
           <span class="cat-pill" onclick="filterAdminCategory('อื่น ๆ', this)">อื่น ๆ</span>
        </div>
      </div>

      <div id="tab-products" class="admin-tab-content">
        <div class="row g-3" id="adminProductGrid"></div>
      </div>
      <div id="tab-orders" class="admin-tab-content" style="display:none;">
        <div id="adminOrderList" class="p-2"></div>
      </div>
      <div id="tab-customers" class="admin-tab-content" style="display:none;">
        <div class="row g-2" id="adminCustomerGrid"></div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="productModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content rounded-4"><div class="modal-header border-0"><h5>จัดการสินค้า</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
    <input type="hidden" id="pId">
    <div class="mb-2"><label class="small text-muted">รูปภาพสินค้า (สูงสุด 5 รูป)</label></div>
    <div class="img-upload-container">
       <div class="img-upload-main" onclick="triggerImgUpload(0)">
         <div class="upload-placeholder"><i class="bi bi-plus-lg"></i></div>
         <img id="img-preview-0" class="uploaded-img" style="display:none;">
         <div id="btn-rm-0" class="btn-remove-img" style="display:none;" onclick="event.stopPropagation(); removeImg(0);">X</div>
         <input type="file" id="file-input-0" accept="image/*" style="display:none;" onchange="handleFileSelect(this, 0)">
       </div>
       <div class="img-upload-grid">
         <div class="img-upload-sub" onclick="triggerImgUpload(1)">
            <div class="upload-placeholder"><i class="bi bi-plus-lg"></i></div>
            <img id="img-preview-1" class="uploaded-img" style="display:none;">
            <div id="btn-rm-1" class="btn-remove-img" style="display:none;" onclick="event.stopPropagation(); removeImg(1);">X</div>
            <input type="file" id="file-input-1" accept="image/*" style="display:none;" onchange="handleFileSelect(this, 1)">
