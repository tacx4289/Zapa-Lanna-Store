    function addToCart(id, name, price, img, desc, qty=1, category='', watermarkName='') { 
      if(isGuestMode) { requireLoginAlert(); return; }
      const f = cart.find(x => x.id === id); 
      if(f) { 
         f.qty += qty; 
         if(category) f.category = category;
         if(watermarkName) f.watermarkName = watermarkName;
      } else {
         cart.push({id, name, price, img, desc, qty: qty, selected: false, category: category || '', watermarkName: watermarkName || ''});
      }
      saveCart(); updateCartUI(); alert('เพิ่มสินค้าลงตะกร้าแล้ว'); 
    }

    function openCart() { 
      if(isGuestMode) { requireLoginAlert(); return; }
      cart.forEach(item => item.selected = false); updateCartUI(); cModal.show(); 
    }
    function saveCart() { localStorage.setItem('shopCart', JSON.stringify(cart)); }
    function updateCartBadge() { const el = document.getElementById('cartCount'); if(el) el.innerText = cart.reduce((a, b) => a + b.qty, 0); }

    function updateCartUI() {
      updateCartBadge();
      let total = 0;
