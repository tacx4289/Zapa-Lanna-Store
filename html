    function printShippingLabel(orderId) {
      const order = allAdminOrders.find(o => o[0] === orderId);
      if(!order) return;
      let items = []; try { items = JSON.parse(order[5]); } catch(e) {}
      const itemText = items.map(it => `${it.name} (x${it.qty})`).join(', ');
      let sender = {};
      try { sender = JSON.parse(localStorage.getItem('adminProfile')) || {}; } catch(e) {}

      function buildCleanAddress(addrStr) {
        if(!addrStr) return '-';
        const patterns = [
          { label: 'เลขที่',         re: /เลขที่\s*([^,]+)/ },
          { label: 'หมู่บ้าน',       re: /หมู่บ้าน\s*([^,]+)/ },
          { label: 'หมู่ที่',        re: /หมู่ที่\s*([^,]+)/ },
          { label: 'ถนน',            re: /ถนน\s*([^,]+)/ },
          { label: 'ซอย',            re: /ซอย\s*([^,]+)/ },
          { label: 'ตำบล/แขวง',     re: /ตำบล\/แขวง\s*([^,]+)/ },
          { label: 'อำเภอ/เขต',     re: /อำเภอ\/เขต\s*([^,]+)/ },
          { label: 'จังหวัด',        re: /จังหวัด\s*([^,]+)/ },
          { label: 'รหัสไปรษณีย์',  re: /รหัสไปรษณีย์\s*([^,]+)/ }
        ];
        const parts = [];
        patterns.forEach(p => {
          const m = addrStr.match(p.re);
          if(m) {
            const val = m[1].trim();
            if(val && val !== '-' && val !== '') {
              parts.push(p.label + ' ' + val);
            }
          }
        });
        return parts.length > 0 ? parts.join(', ') : addrStr;
      }

      const cleanReceiverAddress = buildCleanAddress(order[8]);

      const printWin = window.open('', '_blank');
      printWin.document.write(`<html><head><title>ใบปะหน้า - ${orderId}</title><link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;600&display=swap" rel="stylesheet"><style>body{font-family:'Kanit',sans-serif;padding:20px;color:#333}.label-card{border:2px solid #000;padding:20px;border-radius:8px;max-width:500px;margin:auto}.section{border-bottom:1px dashed #999;padding-bottom:15px;margin-bottom:15px}.section:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}.label-title{font-weight:600;color:#555;font-size:0.85rem;text-decoration:underline;margin-bottom:8px;display:block}.info-name{font-weight:600;font-size:1.15rem;display:block}.info-address{font-size:1rem;line-height:1.5;display:block;margin-top:5px}.items-box{background:#f8f8f8;padding:10px;border:1px solid #ddd;margin-top:15px;font-size:0.9rem}@media print{.no-print{display:none}}<\/style></head><body><div class="label-card"><div class="section"><span class="label-title">ผู้ส่ง (Sender):</span><span class="info-name">${sender.name||'-'} (${sender.phone||'-'})</span><span class="info-address">${sender.address||'-'}</span></div><div class="section"><span class="label-title">ผู้รับ (Receiver):</span><span class="info-name">${order[7]} (${order[9]})</span><span class="info-address">${cleanReceiverAddress}</span></div><div class="items-box"><strong>รายการสินค้า:</strong> ${itemText}</div><div class="mt-4 no-print" style="margin-top:20px;text-align:center;"><button onclick="window.print()" style="padding:10px 25px;background:#0d6efd;color:white;border:none;border-radius:5px;cursor:pointer;font-family:'Kanit';">พิมพ์ใบปะหน้า</button></div></div></body></html>`);
      printWin.document.close();
    }

    // ฟังก์ชันค้นหา
    function handleUniversalSearch() {
       const q = document.getElementById('universalSearch').value.toLowerCase();
       const activeTab = document.querySelector('.admin-tab-content[style*="display: block"]')?.id || 'tab-products';
       const countEl = document.getElementById('searchResultCount');
       
       let count = 0;

       if(activeTab === 'tab-orders') {
          const filtered = allAdminOrders.filter(o => 
             o[0].toString().toLowerCase().includes(q) || 
             o[9].toString().includes(q) ||               
             (o[7] || "").toString().toLowerCase().includes(q) || 
             (o[4] || "").toString().toLowerCase().includes(q)    
          );
          renderAdminOrders(filtered);
          count = filtered.length;
       } else if(activeTab === 'tab-customers') {
          const filtered = allAdminUsers.filter(u => u[2].toLowerCase().includes(q) || u[4].includes(q));
          renderAdminUsers(filtered);
          count = filtered.length;
       } else {
          const filtered = allAdminProducts.filter(p => p[1].toLowerCase().includes(q));
          renderAdminProducts(filtered);
          count = filtered.length;
       }

       if(q.length > 0) {
          countEl.innerText = 'พบ ' + count + ' รายการ';
       } else {
          countEl.innerText = '';
       }
    }

