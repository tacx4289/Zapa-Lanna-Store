    function saveEditUser() {
      // ตรวจสอบว่ากรอกครบทุกช่อง
      const addrFields = ['uAddr_no','uAddr_village','uAddr_moo','uAddr_road','uAddr_soi','uAddr_tambon','uAddr_amphoe','uAddr_province','uAddr_postcode'];
