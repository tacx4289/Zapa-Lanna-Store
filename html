  <!-- ===================================================================
       API CONNECTOR : เชื่อมหน้าบ้าน (GitHub Pages) -> หลังบ้าน (Google Apps Script + Google Sheets)
       จำลอง google.script.run ให้ทำงานเหมือนเดิมทุกอย่าง จึงไม่ต้องแก้โค้ดส่วนอื่น
       *** ตั้งค่า URL ของ Web App ได้ที่ API_URL ด้านล่างเท่านั้น ***
       =================================================================== -->
  <script>
    const API_URL = 'https://script.google.com/macros/s/AKfycbwYhNK1VZhDnivGOQqyCE0FflsI3m_fZlywG-LXRBuKnWTvsOeItHvFC3Pz-yiqVNw4kA/exec';

    (function () {
      async function callApi(fn, args) {
        const res = await fetch(API_URL, {
          method: 'POST',
          // ใช้ text/plain เพื่อเลี่ยง CORS preflight (Apps Script ไม่รองรับ OPTIONS)
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ fn: fn, args: args }),
          redirect: 'follow'
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const json = await res.json();
        if (!json || json.ok !== true) throw new Error((json && json.error) || 'Unknown server error');
        return json.result === undefined ? null : json.result;
      }

      function makeRunner(onSuccess, onFailure) {
        return new Proxy({}, {
          get: function (_, name) {
            if (typeof name !== 'string') return undefined;
            if (name === 'withSuccessHandler') return function (fn) { return makeRunner(fn, onFailure); };
            if (name === 'withFailureHandler') return function (fn) { return makeRunner(onSuccess, fn); };
            return function () {
              const args = Array.prototype.slice.call(arguments);
              callApi(name, args).then(function (result) {
                if (typeof onSuccess === 'function') onSuccess(result);
              }).catch(function (err) {
                console.error('API error [' + name + ']:', err);
                if (typeof onFailure === 'function') onFailure(err);
              });
            };
          }
        });
      }

      window.google = window.google || {};
      window.google.script = window.google.script || {};
      window.google.script.run = makeRunner(null, null);
    })();
