    // --- Product Modal and Image Upload Logic ---
    function openProductModal(p=null) {
      document.getElementById('pId').value = p ? p[0] : '';
      document.getElementById('pName').value = p ? p[1] : '';
      document.getElementById('pPrice').value = p ? p[2] : '';
      document.getElementById('pStock').value = p ? p[3] : '';
      document.getElementById('pDescription').value = p ? p[5] : '';
      document.getElementById('pCategory').value = p ? (p[7] || 'อื่น ๆ') : 'อื่น ๆ';
      
      currentProductImgs = ["", "", "", "", ""];
      currentProductFiles = [null, null, null, null, null];
      
      if(p && p[4]) {
        try {
          let loadedImgs = JSON.parse(p[4]);
          if(Array.isArray(loadedImgs)) {
             for(let i=0; i<loadedImgs.length; i++) {
                if(i < 5) currentProductImgs[i] = loadedImgs[i];
             }
          } else {
             currentProductImgs[0] = p[4];
          }
        } catch(e) {
           currentProductImgs[0] = p[4];
        }
      }
      refreshImgUI();
      pModal.show();
    }
    
    function refreshImgUI() {
       for(let i=0; i<5; i++) {
          const imgEl = document.getElementById('img-preview-'+i);
          const btnRm = document.getElementById('btn-rm-'+i);
          const placeholder = document.querySelector(`#img-preview-${i}`).parentNode.querySelector('.upload-placeholder');
          
          if(currentProductImgs[i]) {
             imgEl.src = currentProductImgs[i];
             imgEl.style.display = 'block';
             btnRm.style.display = 'flex';
             placeholder.style.display = 'none';
          } else {
             imgEl.src = '';
             imgEl.style.display = 'none';
             btnRm.style.display = 'none';
             placeholder.style.display = 'flex';
          }
       }
    }

    function triggerImgUpload(idx) { document.getElementById('file-input-'+idx).click(); }
    function handleFileSelect(input, idx) {
       if(input.files && input.files[0]) {
          currentProductFiles[idx] = input.files[0];
          const r = new FileReader();
          r.onload = e => { 
             currentProductImgs[idx] = e.target.result; // temp preview
             refreshImgUI(); 
          };
          r.readAsDataURL(input.files[0]);
       }
    }
    function removeImg(idx) {
       currentProductImgs[idx] = "";
       currentProductFiles[idx] = null;
       document.getElementById('file-input-'+idx).value = "";
       refreshImgUI();
    }

    function handleSaveProduct() {
      const pId = document.getElementById('pId').value;
      const name = document.getElementById('pName').value;
      const price = document.getElementById('pPrice').value;
      const stock = document.getElementById('pStock').value;
      const desc = document.getElementById('pDescription').value;
      const category = document.getElementById('pCategory').value;
      const btn = document.getElementById('pSubmitBtn');
      btn.disabled = true; btn.innerText = 'กำลังอัปโหลดรูปภาพ...';
      
      uploadImagesRecursive(0, [], function(uploadedUrls) {
          const finalData = { 
             productId: pId, 
             name: name, 
             price: price, 
             stock: stock, 
             description: desc,
             category: category,
             images: JSON.stringify(uploadedUrls)
          };
          
          if(pId) google.script.run.withSuccessHandler(() => { pModal.hide(); loadAdminData(); btn.disabled=false;btn.innerText='บันทึกข้อมูลสินค้า'; }).updateProduct(finalData);
          else google.script.run.withSuccessHandler(() => { pModal.hide(); loadAdminData(); btn.disabled=false;btn.innerText='บันทึกข้อมูลสินค้า'; }).addProduct(finalData);
      });
    }
    
    function uploadImagesRecursive(idx, collectedUrls, callback) {
       if(idx >= 5) {
          const finalUrls = collectedUrls.filter(u => u && u.length > 0);
          callback(finalUrls);
          return;
       }
       
       if(currentProductFiles[idx]) {
          const reader = new FileReader();
          reader.onload = e => {
             google.script.run.withSuccessHandler(url => {
                collectedUrls.push(url);
                uploadImagesRecursive(idx+1, collectedUrls, callback);
             }).uploadFile(e.target.result, currentProductFiles[idx].name);
          };
          reader.readAsDataURL(currentProductFiles[idx]);
       } 
       else if(currentProductImgs[idx] && currentProductImgs[idx].startsWith('http')) {
          collectedUrls.push(currentProductImgs[idx]);
          uploadImagesRecursive(idx+1, collectedUrls, callback);
       }
       else {
          collectedUrls.push("");
          uploadImagesRecursive(idx+1, collectedUrls, callback);
       }
    }

